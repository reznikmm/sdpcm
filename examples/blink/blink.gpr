with "config/blink_config.gpr";
with "runtime_build.gpr";

project Blink is
   for Target              use Runtime_Build'Target;
   for Runtime ("Ada")     use Runtime_Build'Runtime ("Ada");

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Blink_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("blink.adb");

   package Compiler is
      for Default_Switches ("Ada") use Blink_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Linker is
      for Switches ("Ada") use
        Runtime_Build.Linker_Switches &
        ("-Wl,--gc-sections",
         "-Wl,-Map=map.txt",
         "-Wl,--defsym=__stack_size=0x2000");
   end Linker;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

   package Ide is
      for Program_Host use "localhost:4242";
      for Communication_Protocol use "remote";
      for Connection_Tool use "openocd";
      for Connection_Config_Files use ("board/pico-debug.cfg");
   end Ide;

end Blink;
